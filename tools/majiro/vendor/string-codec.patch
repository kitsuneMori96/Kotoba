@@ -9,9 +9,75 @@ namespace Majiro {
 	public static class Helpers {
 		public static readonly Encoding ShiftJis;
 
+		// Local patch: string literal codec is switchable for UTF-8 script experiments.
+		public static readonly Encoding StringEncoding;
+
+		// Decoder that turns bytes it cannot decode into U+E000+byte markers, so that
+		// Majiro inline control codes such as 0x81 0x01 survive a decode/encode cycle.
+		public static readonly Encoding StringReadEncoding;
+
+		public static bool Utf8Strings { get; private set; }
+
 		static Helpers() {
 			Encoding.RegisterProvider(CodePagesEncodingProvider.Instance);
 			ShiftJis = Encoding.GetEncoding(932, EncoderFallback.ExceptionFallback, DecoderFallback.ExceptionFallback);
+			Utf8Strings = string.Equals(Environment.GetEnvironmentVariable("MAJIRO_STRENC"), "utf8", StringComparison.OrdinalIgnoreCase);
+			StringEncoding = Utf8Strings ? new UTF8Encoding(false, true) : ShiftJis;
+			var inner = Utf8Strings ? new UTF8Encoding(false, false) : Encoding.GetEncoding(932);
+			StringReadEncoding = Encoding.GetEncoding(inner.CodePage,
+				EncoderFallback.ReplacementFallback, new RawByteDecoderFallback());
+		}
+
+		public const char RawByteBase = '\uE000';
+
+		public static string DecodeString(byte[] bytes) {
+			string text = StringReadEncoding.GetString(bytes);
+			var sb = new StringBuilder(text.Length);
+			foreach(char c in text)
+				sb.Append(c <= '\u001F' || c == '\u007F' ? (char)(RawByteBase + c) : c);
+			return sb.ToString();
+		}
+
+		public static byte[] EncodeString(string value) {
+			var buffer = new MemoryStream();
+			for(int i = 0; i < value.Length; i++) {
+				char c = value[i];
+				if(c >= RawByteBase && c <= RawByteBase + 0xFF) {
+					buffer.WriteByte((byte)(c - RawByteBase));
+					continue;
+				}
+				int len = char.IsHighSurrogate(c) && i + 1 < value.Length && char.IsLowSurrogate(value[i + 1]) ? 2 : 1;
+				byte[] encoded = StringEncoding.GetBytes(value.ToCharArray(i, len));
+				buffer.Write(encoded, 0, encoded.Length);
+				i += len - 1;
+			}
+			return buffer.ToArray();
+		}
+
+		public sealed class RawByteDecoderFallback : DecoderFallback {
+			public override int MaxCharCount => 8;
+			public override DecoderFallbackBuffer CreateFallbackBuffer() => new Buffer();
+
+			private sealed class Buffer : DecoderFallbackBuffer {
+				private byte[] bytes = Array.Empty<byte>();
+				private int index;
+				public override int Remaining => bytes.Length - index;
+				public override bool Fallback(byte[] bytesUnknown, int indexInStream) {
+					bytes = bytesUnknown;
+					index = 0;
+					return bytes.Length > 0;
+				}
+				public override char GetNextChar() => index < bytes.Length ? (char)(RawByteBase + bytes[index++]) : '\0';
+				public override bool MovePrevious() {
+					if(index <= 0) return false;
+					index--;
+					return true;
+				}
+				public override void Reset() {
+					bytes = Array.Empty<byte>();
+					index = 0;
+				}
+			}
 		}
 
